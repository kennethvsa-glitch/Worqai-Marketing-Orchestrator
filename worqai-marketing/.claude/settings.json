{
  "permissions": {
    "allow": [
      "Bash(chmod +x .claude/hooks/*)",
      "Bash(/c/Users/kenne/AppData/Local/Programs/Python/Python311/python.exe -c ' *)",
      "Bash(py scripts/carousel_exporter.py --input production/carousel_mentiras-reclutadores_crimson.html --output export/)",
      "Edit(/.claude/skills/design-systems/**)",
      "Edit(/.claude/skills/html-carousel-builder/**)",
      "Bash(/c/Users/kenne/AppData/Local/Programs/Python/Python311/python.exe scripts/render_carousel.py scripts/test-spec.json --output production/carousel_ats-pdf-test_s17.html)",
      "Bash(py -3 -c ' *)"
    ],
    "deny": [
      "Bash(wget * | sh)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/format-check.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"additionalContext\": \"WorqAI marketing project. Primary brand: WorqAI (resume builder SaaS). Secondary: Profile Pro LATAM (done-for-you service). Read CLAUDE.md for routing.\"}'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/bash-guard.sh"
          }
        ]
      }
    ]
  }
}
