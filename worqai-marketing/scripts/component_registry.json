{
  "$schema": "https://worqai.app/schemas/component-registry-v1.json",
  "description": "Maps each carousel component to its supported design systems and tier. Used by render_carousel.py and the html-carousel-builder skill to enforce per-system component allowlists. '*' means universal compatibility.",
  "tier_definitions": {
    "1_geo": "Background atmosphere layers (single per-slide, z-index 1-3)",
    "2_chrome": "Frame elements that wrap the slide (brand, counter, header, badge)",
    "3_layout": "Full slide compositions (one per slide, z-index 5)",
    "4_sub": "Reusable inline parts embedded inside layouts (stamps, pills, cards)"
  },
  "system_groups": {
    "dark": ["s01","s02","s03","s06","s08","s09","s10","s11","s12","s13","s14","s15","s16","s17","s20","s21","s22","s24","s27","s28","s30","s31","s32"],
    "light": ["s05","s18","s19","s23","s26","s39","s47","s48"],
    "brutalist": ["s07","s25"],
    "warm": ["s04"],
    "cyberpunk": ["s29"],
    "all": ["*"]
  },
  "components": {
    "geo": {
      "pw-grid":         { "tier": "1_geo", "systems": ["dark","cyberpunk"], "note": "Existing — perspective wireframe grid" },
      "grid-bg":         { "tier": "1_geo", "systems": ["brutalist","light"], "note": "Existing — flat 2D grid" },
      "glow-orb":        { "tier": "1_geo", "systems": ["dark","cyberpunk"], "note": "Existing" },
      "vol-light":       { "tier": "1_geo", "systems": ["warm"], "note": "Existing" },
      "blob-bg":         { "tier": "1_geo", "systems": ["warm","light"], "note": "Existing" },
      "diag-band":       { "tier": "1_geo", "systems": ["light","brutalist"], "note": "Existing" },
      "zoom-rings":      { "tier": "1_geo", "systems": ["dark","cyberpunk"], "note": "Existing" },
      "scan-lines":      { "tier": "1_geo", "systems": ["cyberpunk"], "note": "Existing — overlay scanlines" },
      "geo-mesh-noise":  { "tier": "1_geo", "systems": ["warm","light"], "note": "Animated soft mesh-gradient blob" },
      "geo-pixel-grid":  { "tier": "1_geo", "systems": ["cyberpunk","dark"], "note": "Tight dot-matrix instead of lines" },
      "geo-conic-rays":  { "tier": "1_geo", "systems": ["brutalist","warm"], "note": "Conic sunburst from corner" },
      "geo-chevron-stripe":{ "tier": "1_geo", "systems": ["brutalist","dark"], "note": "Diagonal repeating chevrons" },
      "geo-iso-grid":    { "tier": "1_geo", "systems": ["dark","brutalist"], "note": "Isometric grid (no perspective rotation)" },
      "geo-paper-texture":{ "tier": "1_geo", "systems": ["light"], "note": "Organic paper-fiber grain" },
      "geo-halftone":    { "tier": "1_geo", "systems": ["brutalist","light"], "note": "Print-style halftone dot gradient" },
      "geo-ribbon-flow": { "tier": "1_geo", "systems": ["warm","light"], "note": "Bezier ribbons" },
      "geo-circuit-trace":{ "tier": "1_geo", "systems": ["cyberpunk"], "note": "PCB circuit lines — s29 only" },
      "geo-topo-lines":  { "tier": "1_geo", "systems": ["dark","brutalist"], "note": "Topographic contour lines" },
      "geo-starfield":   { "tier": "1_geo", "systems": ["dark","cyberpunk"], "note": "Sparse dot scatter" },
      "geo-gradient-bands":{ "tier": "1_geo", "systems": ["warm","light"], "note": "Horizontal stripe gradient bands" },
      "svg-blob-tr":         { "tier": "1_geo", "systems": ["*"], "note": "v2 — organic SVG blob, top-right. Replaces ellipse blob-bg." },
      "svg-blob-bl":         { "tier": "1_geo", "systems": ["*"], "note": "v2 — organic SVG blob, bottom-left." },
      "svg-blob-center":     { "tier": "1_geo", "systems": ["*"], "note": "v2 — centered organic SVG blob, low opacity for hero behind." },
      "svg-blob-asymmetric": { "tier": "1_geo", "systems": ["*"], "note": "v2 — aggressive asymmetric SVG blob, top-right." },
      "svg-blob-scattered":  { "tier": "1_geo", "systems": ["*"], "note": "v2 — three scattered small SVG blobs, atmosphere layer." }
    },
    "chrome": {
      "brand":           { "tier": "2_chrome", "systems": ["*"], "note": "Existing — bottom-left handle" },
      "counter":         { "tier": "2_chrome", "systems": ["*"], "note": "Existing — bottom-right NN/NN" },
      "swipe-pill":      { "tier": "2_chrome", "systems": ["*"], "note": "Existing — slide 1 only" },
      "kicker":          { "tier": "2_chrome", "systems": ["*"], "note": "Existing — top label with bar" },
      "prog":            { "tier": "2_chrome", "systems": ["*"], "note": "Existing — bottom-center dots" },
      "chrome-vertical-counter":{ "tier": "2_chrome", "systems": ["light","brutalist"], "note": "Rotated counter on right edge" },
      "chrome-badge-stamp":{ "tier": "2_chrome", "systems": ["*"], "note": "Wax-seal stamp top-right" },
      "chrome-header-bar":{ "tier": "2_chrome", "systems": ["light"], "note": "Magazine top bar — light editorial only" },
      "svg-starburst-spark":  { "tier": "2_chrome", "systems": ["*"], "note": "v2 — 10-point SVG starburst, replaces ✦ unicode. Compact (48px)." },
      "svg-starburst-burst":  { "tier": "2_chrome", "systems": ["*"], "note": "v2 — 8-point double-layer SVG starburst, replaces ✦✧✦ ornament." },
      "svg-starburst-mark":   { "tier": "2_chrome", "systems": ["*"], "note": "v2 — 16-point fine SVG starburst, decorative cluster." }
    },
    "layout": {
      "slide-hook-lockup":   { "tier": "3_layout", "systems": ["*"], "note": "Existing" },
      "slide-big-number":    { "tier": "3_layout", "systems": ["*"], "note": "Existing" },
      "slide-terminal":      { "tier": "3_layout", "systems": ["dark","cyberpunk"], "note": "Existing — tech feel" },
      "slide-tip-blocks":    { "tier": "3_layout", "systems": ["*"], "note": "Existing" },
      "slide-before-after":  { "tier": "3_layout", "systems": ["*"], "note": "Existing" },
      "slide-checklist":     { "tier": "3_layout", "systems": ["*"], "note": "Existing" },
      "slide-proof":         { "tier": "3_layout", "systems": ["*"], "note": "Existing" },
      "slide-cta":           { "tier": "3_layout", "systems": ["*"], "note": "Existing" },
      "slide-pull-quote":    { "tier": "3_layout", "systems": ["*"], "note": "Existing" },
      "slide-myth-vs-fact":  { "tier": "3_layout", "systems": ["*"], "note": "Myth bubble + fact callout" },
      "slide-step-flow":     { "tier": "3_layout", "systems": ["*"], "note": "Horizontal 4-step process w/ arrows" },
      "slide-comparison-table":{ "tier": "3_layout", "systems": ["*"], "note": "2-3 column matrix with checkmarks" },
      "slide-faq-stack":     { "tier": "3_layout", "systems": ["*"], "note": "Q&A stack" },
      "slide-quote-cascade": { "tier": "3_layout", "systems": ["*"], "note": "Multiple short testimonial fragments" },
      "slide-bento-grid":    { "tier": "3_layout", "systems": ["*"], "note": "2x2 or 3x3 bento cards" },
      "slide-timeline":      { "tier": "3_layout", "systems": ["*"], "note": "Vertical timeline with milestones" },
      "slide-stat-row":      { "tier": "3_layout", "systems": ["*"], "note": "3 stat cards side-by-side" },
      "slide-pull-quote-author":{ "tier": "3_layout", "systems": ["*"], "note": "Quote + author photo + tagline" },
      "slide-warning-banner":{ "tier": "3_layout", "systems": ["*"], "note": "Single alert card, sparse text" },
      "slide-icon-grid":     { "tier": "3_layout", "systems": ["*"], "note": "6 icon+label tiles" },
      "slide-progress-bars": { "tier": "3_layout", "systems": ["*"], "note": "Metric improvement bars" },
      "slide-list-numbered": { "tier": "3_layout", "systems": ["*"], "note": "Large ranked numbered list" },
      "slide-data-viz-donut":{ "tier": "3_layout", "systems": ["dark","cyberpunk","light"], "note": "Donut chart + legend" },
      "slide-typeset-poster":{ "tier": "3_layout", "systems": ["brutalist","light"], "note": "Type-as-art poster" }
    },
    "sub": {
      "sub-stamp-circle":    { "tier": "4_sub", "systems": ["*"], "note": "Round badge NUEVO/GRATIS/URGENTE" },
      "sub-pill-tag":        { "tier": "4_sub", "systems": ["*"], "note": "Small accent category pill" },
      "sub-arrow-flow":      { "tier": "4_sub", "systems": ["*"], "note": "Directional arrow between steps" },
      "sub-icon-circle":     { "tier": "4_sub", "systems": ["*"], "note": "Circular icon container 24-48px" },
      "sub-dotted-divider":  { "tier": "4_sub", "systems": ["*"], "note": "Horizontal dotted separator" },
      "sub-rating-stars":    { "tier": "4_sub", "systems": ["*"], "note": "5-star rating row" },
      "sub-logo-row":        { "tier": "4_sub", "systems": ["*"], "note": "'As seen in' press logos" },
      "sub-avatar-stack":    { "tier": "4_sub", "systems": ["*"], "note": "Overlapping circular avatars" },
      "sub-fact-bubble":     { "tier": "4_sub", "systems": ["*"], "note": "Speech bubble for myth-vs-fact" },
      "sub-timeline-dot":    { "tier": "4_sub", "systems": ["*"], "note": "Connector dot for timeline" },
      "sub-bento-card":      { "tier": "4_sub", "systems": ["*"], "note": "Base card for bento grid" },
      "sub-inline-stat":     { "tier": "4_sub", "systems": ["*"], "note": "Large accent stat inline" },
      "sub-status-pill":     { "tier": "4_sub", "systems": ["*"], "note": "Pass/fail/warn colored pill" },
      "sub-comment-mock":    { "tier": "4_sub", "systems": ["*"], "note": "Fake IG/LinkedIn comment" },
      "sub-handle-line":     { "tier": "4_sub", "systems": ["*"], "note": "@user · 2h attribution line" },
      "sub-stat-card":       { "tier": "4_sub", "systems": ["*"], "note": "Base card for stat-row" },
      "sub-chip-list":       { "tier": "4_sub", "systems": ["*"], "note": "Small chip/tag list" },
      "sub-download-card":   { "tier": "4_sub", "systems": ["*"], "note": "File icon + download CTA" },
      "sub-emoji-callout":   { "tier": "4_sub", "systems": ["*"], "note": "Single large emoji + caption" },
      "sub-swipe-arrow-stack":{ "tier": "4_sub", "systems": ["*"], "note": "Vertical chevron stack" }
    },
    "primitives": {
      "_description": "v2 visual primitives — opt-in via spec fields (text_treatment, effects, layers, decoratives). All html2canvas-safe via SVG-first design.",
      "txt-gradient":     { "tier": "5_primitive", "systems": ["*"], "note": "v2 — SVG <text> with linearGradient fill. Use via copy.text_treatment='gradient'." },
      "txt-glow-subtle":  { "tier": "5_primitive", "systems": ["*"], "note": "v2 — light neon-glow text-shadow." },
      "txt-glow-medium":  { "tier": "5_primitive", "systems": ["*"], "note": "v2 — medium neon-glow text-shadow." },
      "txt-glow-bold":    { "tier": "5_primitive", "systems": ["*"], "note": "v2 — bold neon-glow text-shadow." },
      "txt-stroke":       { "tier": "5_primitive", "systems": ["*"], "note": "v2 — -webkit-text-stroke outlined text (Supreme/Nike aesthetic). Use via copy.text_treatment='stroke'." },
      "txt-stroke-filled":{ "tier": "5_primitive", "systems": ["*"], "note": "v2 — stroke with filled interior." },
      "shadow-sm":        { "tier": "5_primitive", "systems": ["*"], "note": "v2 — SVG feDropShadow filter (CSS box-shadow broken in html2canvas)." },
      "shadow-md":        { "tier": "5_primitive", "systems": ["*"], "note": "v2 — medium SVG drop-shadow." },
      "shadow-lg":        { "tier": "5_primitive", "systems": ["*"], "note": "v2 — strong SVG drop-shadow." },
      "icon-sprite":      { "tier": "5_primitive", "systems": ["*"], "note": "v2 — 21 SVG icons in a single <defs> sprite at top of carousel. Reference via <use href='#icon-NAME'/>. Names: warning, error, ok, info, clock, arrow-right, arrow-down, arrow-curved, arrow-thick, chart, trending-up, trending-down, target, lock, key, shield, heart, lightning, trophy, star, magnifier." },
      "grain-texture":    { "tier": "5_primitive", "systems": ["*"], "note": "v2 — real SVG feTurbulence grain (replaces faint 0.035 opacity). Auto-applied to every slide via shell. Override via effects.grain_opacity." },
      "blob-drift":       { "tier": "5_primitive", "systems": ["*"], "note": "v2 — opt-in 60s rotation animation on svg-blob-*. Live preview gets motion; html2canvas captures still frame. Enable via layer dict: {id: 'svg-blob-tr', animate: true}." }
    }
  }
}
