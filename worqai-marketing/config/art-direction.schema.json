{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VisualLanguageContract",
  "type": "object",
  "required": ["audience", "objective", "tone", "concept", "typography", "color_roles", "composition", "restraint", "continuity", "prohibited_patterns"],
  "properties": {
    "audience": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "tone": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "concept": {"type": "string", "minLength": 1},
    "typography": {"type": "object", "required": ["display", "body"], "additionalProperties": {"type": "string"}},
    "color_roles": {"type": "object", "required": ["background", "text", "accent"], "additionalProperties": {"type": "string"}},
    "composition": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "restraint": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "continuity": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "prohibited_patterns": {"type": "array", "items": {"type": "string"}},
    "deliberate_deviations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
