+import type { Metadata } from "next";
+import { routing } from "@/i18n/routing";
+import { absoluteSiteUrl, SITE_NAME } from "@/lib/seo/site";
+
+export const INDEXABLE_PATHS = [
+  "",
+  "auditoria",
+  "precios",
+  "privacy",
+  "terms",
+  "refund",
+] as const;
+
+export type IndexablePath = (typeof INDEXABLE_PATHS)[number];
+export type SeoLocale = (typeof routing.locales)[number];
+
+interface PageSeoCopy {
+  title: string;
+  description: string;
+}
+
+const PAGE_SEO_COPY: Record<
+  SeoLocale,
+  Record<IndexablePath, PageSeoCopy>
+> = {
+  es: {
+    "": {
+      title: "Worqai | Adapta tu CV a cada vacante con IA",
+      description:
+        "Sube tu CV y pega la vacante. Worqai adapta tu experiencia real al puesto y te entrega un CV listo para revisar y postular.",
+    },
+    auditoria: {
+      title: "Analizador de CV ATS gratis | Worqai",
+      description:
+        "Sube tu CV en PDF y recibe un análisis ATS gratis con hallazgos concretos y cambios que puedes aplicar antes de postular.",
+    },
+    precios: {
+      title: "Precios de Worqai | Mejora y adapta tu CV con IA",
+      description:
+        "Compara los planes de Worqai para analizar, mejorar y adaptar tu CV a vacantes específicas.",
+    },
+    privacy: {
+      title: "Política de privacidad | Worqai",
+      description:
+        "Conoce qué datos procesa Worqai, cómo protegemos tu CV y qué opciones tienes para gestionar tu información.",
+    },
+    terms: {
+      title: "Términos del servicio | Worqai",
+      description:
+        "Consulta las condiciones que regulan el uso de Worqai y sus herramientas para analizar, mejorar y adaptar CVs.",
+    },
+    refund: {
+      title: "Política de reembolsos | Worqai",
+      description:
+        "Consulta las condiciones de reembolso aplicables a las compras y suscripciones de Worqai.",
+    },
+  },
+  en: {
+    "": {
+      title: "Worqai | Tailor your resume to every job with AI",
+      description:
+        "Upload your resume and paste the job listing. Worqai adapts your real experience to the role and gives you a resume ready to review and apply with.",
+    },
+    auditoria: {
+      title: "Free ATS resume checker | Worqai",
+      description:
+        "Upload your resume as a PDF for a free ATS analysis with clear findings and practical fixes to make before you apply.",
+    },
+    precios: {
+      title: "Worqai pricing | Analyze and tailor your resume",
+      description:
+        "Compare Worqai plans for checking, improving, and tailoring your resume to specific job listings.",
+    },
+    privacy: {
+      title: "Privacy policy | Worqai",
+      description:
+        "Learn what data Worqai processes, how we protect your resume, and the options you have to manage your information.",
+    },
+    terms: {
+      title: "Terms of service | Worqai",
+      description:
+        "Read the terms that govern your use of Worqai and its resume analysis, improvement, and tailoring tools.",
+    },
+    refund: {
+      title: "Refund policy | Worqai",
+      description:
+        "Read the refund conditions that apply to Worqai purchases and subscriptions.",
+    },
+  },
+};
+
+function normalizeLocale(locale: string): SeoLocale {
+  return routing.locales.includes(locale as SeoLocale)
+    ? (locale as SeoLocale)
+    : routing.defaultLocale;
+}
+
+function localizedPath(locale: SeoLocale, path: IndexablePath): string {
+  return `/${locale}${path ? `/${path}` : ""}`;
+}
+
+export function localizedPageUrl(
+  locale: SeoLocale,
+  path: IndexablePath
+): string {
+  return absoluteSiteUrl(localizedPath(locale, path));
+}
+
+export function languageAlternates(
+  path: IndexablePath
+): Record<string, string> {
+  return {
+    es: localizedPageUrl("es", path),
+    en: localizedPageUrl("en", path),
+    "x-default": localizedPageUrl(routing.defaultLocale, path),
+  };
+}
+
+export function createPageMetadata(
+  rawLocale: string,
+  path: IndexablePath
+): Metadata {
+  const locale = normalizeLocale(rawLocale);
+  const copy = PAGE_SEO_COPY[locale][path];
+  const canonical = localizedPageUrl(locale, path);
+  const image = absoluteSiteUrl(`/cover_${locale}.png`);
+
+  return {
+    title: copy.title,
+    description: copy.description,
+    alternates: {
+      canonical,
+      languages: languageAlternates(path),
+    },
+    robots: { index: true, follow: true },
+    openGraph: {
+      type: "website",
+      siteName: SITE_NAME,
+      title: copy.title,
+      description: copy.description,
+      url: canonical,
+      locale: locale === "es" ? "es_419" : "en_US",
+      alternateLocale: locale === "es" ? "en_US" : "es_419",
+      images: [{ url: image, width: 1731, height: 909, alt: copy.title }],
+    },
+    twitter: {
+      card: "summary_large_image",
+      title: copy.title,
+      description: copy.description,
+      images: [image],
+    },
+  };
+}
diff --git a/src/lib/seo/site.ts b/src/lib/seo/site.ts
new file mode 100644
index 0000000..93c700f
--- /dev/null
+++ b/src/lib/seo/site.ts
@@ -0,0 +1,56 @@
+export const SITE_NAME = "Worqai";
+export const SITE_ORIGIN = "https://www.worqai.io";
+export const APEX_HOSTNAME = "worqai.io";
+export const CANONICAL_HOSTNAME = "www.worqai.io";
+
+export function absoluteSiteUrl(pathname = "/"): string {
+  return new URL(pathname, `${SITE_ORIGIN}/`).toString();
+}
+
+/**
+ * Redirect browser-facing apex requests to the one canonical HTTPS origin.
+ * API and auth callback traffic deliberately remains on the requested host:
+ * webhook providers commonly reject redirects, even when they are permanent.
+ */
+export function canonicalHostRedirectUrl(url: URL): URL | null {
+  const pathname = url.pathname;
+  const isApi = pathname === "/api" || pathname.startsWith("/api/");
+  const isAuthCallback =
+    pathname === "/auth/callback" || pathname.startsWith("/auth/callback/");
+
+  if (url.hostname !== APEX_HOSTNAME || isApi || isAuthCallback) {
+    return null;
+  }
+
+  const destination = new URL(url);
+  destination.protocol = "https:";
+  destination.hostname = CANONICAL_HOSTNAME;
+  destination.port = "";
+  return destination;
+}
+
+export function buildSiteStructuredData() {
+  const organizationId = `${SITE_ORIGIN}/#organization`;
+  const websiteId = `${SITE_ORIGIN}/#website`;
+
+  return {
+    "@context": "https://schema.org",
+    "@graph": [
+      {
+        "@type": "Organization",
+        "@id": organizationId,
+        name: SITE_NAME,
+        url: SITE_ORIGIN,
+        logo: absoluteSiteUrl("/logo2_no_bg.png"),
+      },
+      {
+        "@type": "WebSite",
+        "@id": websiteId,
+        url: SITE_ORIGIN,
+        name: SITE_NAME,
+        inLanguage: ["es", "en"],
+        publisher: { "@id": organizationId },
+      },
+    ],
+  };
+}
