diff --git a/tests/seo/seo-contract.test.ts b/tests/seo/seo-contract.test.ts
new file mode 100644
index 0000000..bf413fd
--- /dev/null
+++ b/tests/seo/seo-contract.test.ts
@@ -0,0 +1,99 @@
+import { describe, expect, it } from "vitest";
+import { routing } from "@/i18n/routing";
+import robots from "@/app/robots";
+import sitemap from "@/app/sitemap";
+import {
+  createPageMetadata,
+  INDEXABLE_PATHS,
+  languageAlternates,
+  localizedPageUrl,
+} from "@/lib/seo/metadata";
+import {
+  buildSiteStructuredData,
+  canonicalHostRedirectUrl,
+  SITE_ORIGIN,
+} from "@/lib/seo/site";
+
+describe("SEO contract", () => {
+  it("emits one sitemap URL per locale and reciprocal alternates", () => {
+    const entries = sitemap();
+
+    expect(entries).toHaveLength(
+      INDEXABLE_PATHS.length * routing.locales.length
+    );
+
+    for (const path of INDEXABLE_PATHS) {
+      const expectedAlternates = languageAlternates(path);
+      for (const locale of routing.locales) {
+        const url = localizedPageUrl(locale, path);
+        const entry = entries.find((candidate) => candidate.url === url);
+        expect(entry).toBeDefined();
+        expect(entry?.alternates?.languages).toEqual(expectedAlternates);
+      }
+    }
+  });
+
+  it("publishes robots and sitemap references on the canonical host", () => {
+    const value = robots();
+    expect(value.host).toBe(SITE_ORIGIN);
+    expect(value.sitemap).toBe(`${SITE_ORIGIN}/sitemap.xml`);
+  });
+
+  it("creates a self-canonical and a complete language cluster", () => {
+    const metadata = createPageMetadata("en", "auditoria");
+
+    expect(metadata.alternates?.canonical).toBe(
+      `${SITE_ORIGIN}/en/auditoria`
+    );
+    expect(metadata.alternates?.languages).toEqual({
+      es: `${SITE_ORIGIN}/es/auditoria`,
+      en: `${SITE_ORIGIN}/en/auditoria`,
+      "x-default": `${SITE_ORIGIN}/es/auditoria`,
+    });
+    expect(metadata.title).toBe("Free ATS resume checker | Worqai");
+  });
+
+  it("keeps structured data limited to claims the site can verify", () => {
+    const value = buildSiteStructuredData();
+    const serialized = JSON.stringify(value);
+
+    expect(value["@graph"].map((node) => node["@type"])).toEqual([
+      "Organization",
+      "WebSite",
+    ]);
+    expect(serialized).not.toContain("SearchAction");
+    expect(serialized).not.toContain("sameAs");
+    expect(serialized).toContain('"inLanguage":["es","en"]');
+  });
+});
+
+describe("canonical host routing", () => {
+  it("builds a canonical HTTPS destination without dropping path or query", () => {
+    const destination = canonicalHostRedirectUrl(
+      new URL("http://worqai.io/en/precios?campaign=launch")
+    );
+
+    expect(destination?.toString()).toBe(
+      "https://www.worqai.io/en/precios?campaign=launch"
+    );
+  });
+
+  it("does not redirect API/webhook or auth callback URLs", () => {
+    expect(
+      canonicalHostRedirectUrl(
+        new URL("https://worqai.io/api/polar/webhook")
+      )
+    ).toBeNull();
+    expect(
+      canonicalHostRedirectUrl(
+        new URL("https://worqai.io/auth/callback?code=abc")
+      )
+    ).toBeNull();
+  });
+
+  it("does not redirect a request that already uses the canonical host", () => {
+    expect(
+      canonicalHostRedirectUrl(new URL("https://www.worqai.io/es"))
+    ).toBeNull();
+  });
+});
