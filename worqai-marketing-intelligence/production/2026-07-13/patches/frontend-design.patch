+import { describe, expect, it } from "vitest";
+import {
+  ACQUISITION_PAGE_PATHS,
+  acquisitionPages,
+  getAcquisitionPage,
+} from "@/lib/seo/acquisition-pages";
+
+describe("acquisition page registry", () => {
+  it("contains the approved 32 localized acquisition routes", () => {
+    expect(acquisitionPages).toHaveLength(32);
+    expect(acquisitionPages.filter((page) => page.kind === "commercial")).toHaveLength(8);
+    expect(acquisitionPages.filter((page) => page.kind === "comparison")).toHaveLength(4);
+    expect(acquisitionPages.filter((page) => page.kind === "role")).toHaveLength(20);
+    expect(ACQUISITION_PAGE_PATHS).toHaveLength(32);
+  });
+
+  it("has unique locale/slug, title, description, and example combinations", () => {
+    const keys = acquisitionPages.map((page) => page.locale + "/" + page.slug);
+    const titles = acquisitionPages.map((page) => page.title);
+    const descriptions = acquisitionPages.map((page) => page.description);
+    const examples = acquisitionPages.map(
+      (page) => page.example.before + "\n" + page.example.after
+    );
+
+    expect(new Set(keys).size).toBe(keys.length);
+    expect(new Set(titles).size).toBe(titles.length);
+    expect(new Set(descriptions).size).toBe(descriptions.length);
+    expect(new Set(examples).size).toBe(examples.length);
+  });
+
+  it("keeps every page useful, bounded, and internally connected", () => {
+    for (const page of acquisitionPages) {
+      expect(page.mechanism.length).toBeGreaterThanOrEqual(3);
+      expect(page.sections).toHaveLength(2);
+      expect(page.checklist.length).toBeGreaterThanOrEqual(4);
+      expect(page.related.length).toBeGreaterThanOrEqual(2);
+      expect(page.example.label.toLowerCase()).toMatch(/ilustrativo|illustrative|escenario/);
+      expect(page.limitation.toLowerCase()).toMatch(/garant|guarantee/);
+      expect(page.privacy.length).toBeGreaterThan(80);
+      expect(page.cta.href.startsWith("/")).toBe(true);
+    }
+  });
+
+  it("labels time-sensitive comparison claims and links their sources", () => {
+    for (const page of acquisitionPages.filter(
+      (candidate) => candidate.kind === "comparison"
+    )) {
+      expect(page.comparison).toBeDefined();
+      expect(page.comparison?.verifiedAt.length).toBeGreaterThan(8);
+      expect(page.comparison?.rows.length).toBeGreaterThanOrEqual(5);
+      expect(
+        page.comparison?.sources.some((source) => source.href.startsWith("https://"))
+      ).toBe(true);
+    }
+  });
+
+  it("returns undefined for unknown routes", () => {
+    expect(getAcquisitionPage("es", "pagina-inventada")).toBeUndefined();
+  });
+});
