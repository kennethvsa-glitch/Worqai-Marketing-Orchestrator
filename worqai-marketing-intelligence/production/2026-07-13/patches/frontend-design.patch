+function rolePage(role: RoleDefinition): AcquisitionPageData {
+  const es = role.locale === "es";
+  return page({
+    locale: role.locale,
+    slug: role.slug,
+    kind: "role",
+    title: role.title,
+    description: role.description,
+    eyebrow: es ? "GUÍA DE CV POR ROL" : "ROLE-SPECIFIC RESUME GUIDE",
+    headline: role.headline,
+    intro: role.intro,
+    promise: role.focus,
+    mechanismTitle: es ? "El mapa de evidencia para este rol" : "The evidence map for this role",
+    mechanismIntro: es
+      ? "No copies esta lista completa. Úsala para localizar los requisitos de la vacante que realmente puedes demostrar."
+      : "Do not copy this whole list. Use it to locate job requirements you can actually demonstrate.",
+    mechanism: role.skills,
+    sections: [
+      {
+        eyebrow: es ? "QUÉ PROBAR" : "WHAT TO PROVE",
+        title: es ? "La experiencia necesita contexto" : "Experience needs context",
+        body: es
+          ? "Tres datos convierten una responsabilidad en evidencia que se puede evaluar."
+          : "Three details turn a responsibility into evidence someone can evaluate.",
+        items: role.evidence,
+      },
+      {
+        eyebrow: es ? "RIESGO COMÚN" : "COMMON RISK",
+        title: role.risk,
+        body: es
+          ? "Corrígelo delimitando tu parte, el contexto y lo que ocurrió de verdad. No llenes el vacío con una cifra decorativa."
+          : "Fix it by defining your contribution, context, and what actually happened. Do not fill the gap with a decorative metric.",
+        items: [role.interviewTest],
+      },
+    ],
+    example: {
+      label: es ? "Ejemplo ilustrativo" : "Illustrative example",
+      context: es
+        ? "Una estructura posible para un perfil de " + role.role + "."
+        : "One possible structure for a " + role.role + " profile.",
+      before: role.before,
+      after: role.after,
+      why: role.why,
+    },
+    checklistTitle: es ? "Antes de enviar este CV" : "Before sending this resume",
+    checklist: es
+      ? [
+          "Comprueba que las habilidades aparecen en experiencia, no solo en una lista.",
+          "Conserva únicamente cifras que puedas explicar.",
+          "Usa el título de la vacante cuando sea equivalente a tu trabajo real.",
+          role.interviewTest,
+        ]
+      : [
+          "Make sure skills appear in experience, not only a list.",
+          "Keep only numbers you can explain.",
+          "Use the job title only when it matches your real work.",
+          role.interviewTest,
+        ],
+    related: role.related,
+  });
+}
+
+export const acquisitionPages: AcquisitionPageData[] = [
+  ...commercialPages,
+  ...comparisonPages,
+  ...roleDefinitions.map(rolePage),
+];
+
+export const ACQUISITION_PAGE_PATHS = acquisitionPages.map(({ locale, slug }) => ({
+  locale,
+  slug,
+  path: "/" + locale + "/" + slug,
+}));
+
+export function getAcquisitionPage(locale: string, slug: string) {
+  return acquisitionPages.find((item) => item.locale === locale && item.slug === slug);
+}
+
+export function getAcquisitionParams() {
+  return acquisitionPages.map(({ locale, slug }) => ({ locale, slug }));
+}
