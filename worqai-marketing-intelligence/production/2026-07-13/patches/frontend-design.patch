+import type { Metadata } from "next";
+import { notFound } from "next/navigation";
+import { setRequestLocale } from "next-intl/server";
+import { AcquisitionPage } from "@/components/seo/acquisition-page";
+import {
+  getAcquisitionPage,
+  getAcquisitionParams,
+} from "@/lib/seo/acquisition-pages";
+
+interface AcquisitionRouteProps {
+  params: Promise<{ locale: string; slug: string }>;
+}
+
+export const dynamicParams = false;
+
+export function generateStaticParams() {
+  return getAcquisitionParams();
+}
+
+export async function generateMetadata({
+  params,
+}: AcquisitionRouteProps): Promise<Metadata> {
+  const { locale, slug } = await params;
+  const content = getAcquisitionPage(locale, slug);
+
+  if (!content) {
+    return {};
+  }
+
+  return {
+    title: content.title,
+    description: content.description,
+    openGraph: {
+      type: "website",
+      title: content.title,
+      description: content.description,
+      url: "/" + locale + "/" + slug,
+      locale,
+    },
+    twitter: {
+      card: "summary_large_image",
+      title: content.title,
+      description: content.description,
+    },
+  };
+}
+
+export default async function AcquisitionRoute({
+  params,
+}: AcquisitionRouteProps) {
+  const { locale, slug } = await params;
+  const content = getAcquisitionPage(locale, slug);
+
+  if (!content) {
+    notFound();
+  }
+
+  setRequestLocale(content.locale);
+
+  return <AcquisitionPage page={content} />;
+}
