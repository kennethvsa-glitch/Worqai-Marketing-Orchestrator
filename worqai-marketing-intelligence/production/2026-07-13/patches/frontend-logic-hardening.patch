diff --git a/tests/seo/private-routes.test.ts b/tests/seo/private-routes.test.ts
new file mode 100644
index 0000000..d3b4ccb
--- /dev/null
+++ b/tests/seo/private-routes.test.ts
@@ -0,0 +1,59 @@
+import { describe, expect, it } from "vitest";
+import { metadata as bienvenida } from "@/app/[locale]/bienvenida/layout";
+import { metadata as cuenta } from "@/app/[locale]/cuenta/layout";
+import { metadata as forgotPassword } from "@/app/[locale]/forgot-password/layout";
+import { metadata as historial } from "@/app/[locale]/historial/layout";
+import { metadata as improve } from "@/app/[locale]/improve/layout";
+import { metadata as login } from "@/app/[locale]/login/layout";
+import { metadata as resetPassword } from "@/app/[locale]/reset-password/layout";
+import { metadata as resultado } from "@/app/[locale]/resultado/layout";
+import { metadata as signup } from "@/app/[locale]/signup/layout";
+import { metadata as tailor } from "@/app/[locale]/tailor/layout";
+import { metadata as verifyEmail } from "@/app/[locale]/verify-email/layout";
+import { metadata as workbench } from "@/app/[locale]/workbench/layout";
+import { createPageMetadata } from "@/lib/seo/metadata";
+import { serializeJsonLd } from "@/lib/seo/site";
+
+const privateRouteMetadata = [
+  bienvenida,
+  cuenta,
+  forgotPassword,
+  historial,
+  improve,
+  login,
+  resetPassword,
+  resultado,
+  signup,
+  tailor,
+  verifyEmail,
+  workbench,
+];
+
+describe("private route SEO boundaries", () => {
+  it("marks every app, account, result, and auth boundary noindex/nofollow", () => {
+    for (const metadata of privateRouteMetadata) {
+      expect(metadata.robots).toMatchObject({
+        index: false,
+        follow: false,
+        googleBot: { index: false, follow: false },
+      });
+    }
+  });
+
+  it("does not change public acquisition pages to noindex", () => {
+    expect(createPageMetadata("es", "").robots).toMatchObject({
+      index: true,
+      follow: true,
+    });
+    expect(createPageMetadata("en", "auditoria").robots).toMatchObject({
+      index: true,
+      follow: true,
+    });
+  });
+
+  it("escapes less-than signs before JSON-LD is embedded in a script", () => {
+    expect(serializeJsonLd({ value: "</script>" })).toBe(
+      '{"value":"\\u003c/script>"}'
+    );
+  });
+});
