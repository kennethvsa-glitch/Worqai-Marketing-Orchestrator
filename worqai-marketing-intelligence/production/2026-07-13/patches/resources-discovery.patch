+++ b/src/lib/seo/resources.ts
@@ -0,0 +1,155 @@
+import {
+  acquisitionPages,
+  type AcquisitionLocale,
+  type AcquisitionPageKind,
+} from "@/lib/seo/acquisition-pages";
+
+export interface ResourceHubItem {
+  href: string;
+  title: string;
+  description: string;
+}
+
+export interface ResourceHubSection {
+  kind: AcquisitionPageKind;
+  title: string;
+  intro: string;
+  items: ResourceHubItem[];
+}
+
+export interface ResourceHubData {
+  locale: AcquisitionLocale;
+  slug: "recursos" | "resources";
+  title: string;
+  description: string;
+  eyebrow: string;
+  heading: string;
+  intro: string;
+  principle: string;
+  sections: ResourceHubSection[];
+  cta: { href: string; label: string };
+  bottomEyebrow: string;
+  bottomHeading: string;
+}
+
+const SECTION_COPY: Record<
+  AcquisitionLocale,
+  Record<AcquisitionPageKind, { title: string; intro: string }>
+> = {
+  es: {
+    commercial: {
+      title: "Resuelve primero el problema de tu CV",
+      intro:
+        "Empieza por la tarea que tienes enfrente: revisar el archivo, compararlo con una vacante o entender qué hace que un formato sea legible.",
+    },
+    comparison: {
+      title: "Compara antes de pagar otra suscripción",
+      intro:
+        "Revisamos diferencias concretas entre herramientas, precios y formas de trabajar. Las comparaciones llevan fecha y fuentes.",
+    },
+    role: {
+      title: "Aterriza tu experiencia al puesto",
+      intro:
+        "Ejemplos por profesión para convertir responsabilidades genéricas en evidencia clara, sin inventar métricas ni proyectos.",
+    },
+  },
+  en: {
+    commercial: {
+      title: "Start with the problem in your resume",
+      intro:
+        "Choose the task in front of you: check the file, compare it with a job, or understand what makes a format readable.",
+    },
+    comparison: {
+      title: "Compare before paying for another subscription",
+      intro:
+        "We look at specific differences in tools, pricing, and workflow. Every comparison includes a review date and sources.",
+    },
+    role: {
+      title: "Connect your experience to the role",
+      intro:
+        "Role-specific examples for turning generic responsibilities into clear evidence without inventing numbers or projects.",
+    },
+  },
+};
+
+const HUB_COPY: Record<AcquisitionLocale, Omit<ResourceHubData, "sections">> = {
+  es: {
+    locale: "es",
+    slug: "recursos",
+    title: "Guías para mejorar y adaptar tu CV | WorqAI",
+    description:
+      "Guías prácticas para revisar un CV, compararlo con una vacante, entender los filtros ATS y escribir mejor tu experiencia profesional.",
+    eyebrow: "GUÍAS DE CV, ATS Y BÚSQUEDA DE EMPLEO",
+    heading: "Menos consejos sueltos. Más cambios que puedes aplicar hoy.",
+    intro:
+      "Esta biblioteca reúne nuestras guías para revisar, adaptar y explicar mejor tu experiencia. Elige el problema que tienes ahora; no necesitas leer todo en orden.",
+    principle:
+      "Un buen CV no intenta gustarle a un algoritmo. Ayuda a que el sistema lea el archivo y a que una persona encuentre evidencia relevante rápido.",
+    cta: { href: "/auditoria", label: "Analizar mi CV gratis" },
+    bottomEyebrow: "SI YA TIENES EL PDF",
+    bottomHeading: "Deja de adivinar qué corregir. Empieza con una revisión concreta.",
+  },
+  en: {
+    locale: "en",
+    slug: "resources",
+    title: "Resume and ATS guides | WorqAI",
+    description:
+      "Practical guides for reviewing a resume, matching it to a job, understanding ATS screening, and writing stronger experience bullets.",
+    eyebrow: "RESUME, ATS, AND JOB SEARCH GUIDES",
+    heading: "Fewer scattered tips. More changes you can use today.",
+    intro:
+      "This library brings together our guides for checking, tailoring, and explaining your experience more clearly. Start with the problem you have now; there is no reading order.",
+    principle:
+      "A strong resume is not written to please an algorithm. It helps software read the file and helps a person find relevant evidence quickly.",
+    cta: { href: "/auditoria", label: "Check my resume free" },
+    bottomEyebrow: "IF YOU ALREADY HAVE THE PDF",
+    bottomHeading: "Stop guessing what to fix. Start with a concrete review.",
+  },
+};
+
+function buildHub(locale: AcquisitionLocale): ResourceHubData {
+  const sections = (["commercial", "comparison", "role"] as const).map(
+    (kind) => ({
+      kind,
+      ...SECTION_COPY[locale][kind],
+      items: acquisitionPages
+        .filter((page) => page.locale === locale && page.kind === kind)
+        .map((page) => ({
+          href: `/${page.slug}`,
+          title: page.headline,
+          description: page.description,
+        })),
+    })
+  );
+
+  return { ...HUB_COPY[locale], sections };
+}
+
+export const resourceHubs = {
+  es: buildHub("es"),
+  en: buildHub("en"),
+} as const;
+
+export const RESOURCE_HUB_PATHS = ["/es/recursos", "/en/resources"] as const;
+
+export function getResourceHub(locale: string, slug: string) {
+  if (locale !== "es" && locale !== "en") return undefined;
+  const hub = resourceHubs[locale];
+  return hub.slug === slug ? hub : undefined;
+}
+
+export function getResourceHubParams() {
+  return Object.values(resourceHubs).map(({ locale, slug }) => ({ locale, slug }));
+}
+
+export function resourceHubCanonicalPath(hub: ResourceHubData) {
+  return `/${hub.locale}/${hub.slug}`;
+}
+
+export function getResourceHubLanguageAlternates() {
+  return {
+    es: "/es/recursos",
+    en: "/en/resources",
+    "x-default": "/es/recursos",
+  } as const;
+}
