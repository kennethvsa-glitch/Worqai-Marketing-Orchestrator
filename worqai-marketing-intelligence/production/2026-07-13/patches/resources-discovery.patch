+              <Link href={hub.cta.href}>
+                {hub.cta.label}
+                <span className="flex size-6 items-center justify-center rounded-full bg-[#c8ff00] text-black">
+                  <ArrowRight className="size-3.5" />
+                </span>
+              </Link>
+            </Button>
+          </div>
+        </div>
+      </section>
+
+      <section className="border-y border-black/10 bg-[#141414] text-white">
+        <div className="mx-auto max-w-[1280px] px-6 py-5">
+          <p className="max-w-[840px] font-heading text-[19px] font-medium leading-7">
+            {hub.principle}
+          </p>
+        </div>
+      </section>
+
+      <div className="mx-auto w-full max-w-[1280px] px-6 py-20 lg:py-28">
+        {hub.sections.map((section, sectionIndex) => (
+          <section
+            key={section.title}
+            className={sectionIndex > 0 ? "mt-20 border-t border-black/10 pt-16" : ""}
+          >
+            <div className="grid gap-5 lg:grid-cols-[0.72fr_1.28fr] lg:gap-16">
+              <div>
+                <p className="font-jetbrains-mono text-[10px] font-semibold uppercase tracking-[0.14em] text-[#5b7807]">
+                  {String(sectionIndex + 1).padStart(2, "0")}
+                </p>
+                <h2 className="mt-4 max-w-[420px] font-heading text-[34px] font-[650] leading-[1.02] tracking-[-0.035em] sm:text-[44px]">
+                  {section.title}
+                </h2>
+                <p className="mt-5 max-w-[440px] text-[15px] leading-7 text-[#555]">
+                  {section.intro}
+                </p>
+              </div>
+
+              <div className="divide-y divide-black/10 border-t border-black/10">
