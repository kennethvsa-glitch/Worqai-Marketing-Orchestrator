diff --git a/src/lib/analytics/attribution.ts b/src/lib/analytics/attribution.ts
new file mode 100644
index 0000000000000000000000000000000000000000..cbd407a424b8ab75780858d848da2db095ae0b50
--- /dev/null
+++ b/src/lib/analytics/attribution.ts
@@ -0,0 +1,163 @@
+import {
+  ANALYTICS_LOCALES,
+  ATTRIBUTION_MEDIA,
+  ATTRIBUTION_SOURCES,
+  LANDING_GROUPS,
+  isOneOf,
+  type AttributionMedium,
+  type AttributionSource,
+  type FirstTouchAttribution,
+  type LandingGroup,
+} from "./contract";
+
+const STORAGE_KEY = "worqai:first-touch:v1";
+
+const SEARCH_HOSTS: ReadonlyArray<[RegExp, AttributionSource]> = [
+  [/(^|\.)google\./, "google"],
+  [/(^|\.)bing\.com$/, "bing"],
+  [/(^|\.)search\.yahoo\.com$/, "other_search"],
+  [/(^|\.)duckduckgo\.com$/, "other_search"],
+];
+
+const SOCIAL_HOSTS: ReadonlyArray<[RegExp, AttributionSource]> = [
+  [/(^|\.)linkedin\.com$/, "linkedin"],
+  [/(^|\.)reddit\.com$/, "reddit"],
+  [/(^|\.)facebook\.com$/, "facebook"],
+  [/(^|\.)instagram\.com$/, "instagram"],
+  [/(^|\.)tiktok\.com$/, "tiktok"],
+];
+
+function sourceFromToken(value: string | null): AttributionSource | null {
+  const token = value?.trim().toLowerCase();
+  if (!token) return null;
+  if (token === "google") return "google";
+  if (token === "bing") return "bing";
+  if (token === "linkedin") return "linkedin";
+  if (token === "reddit") return "reddit";
+  if (token === "facebook" || token === "fb") return "facebook";
+  if (token === "instagram" || token === "ig") return "instagram";
+  if (token === "tiktok") return "tiktok";
+  return "other_campaign";
+}
+
+function mediumFromToken(value: string | null): AttributionMedium | null {
+  const token = value?.trim().toLowerCase();
+  if (!token) return null;
+  if (["cpc", "ppc", "paid", "paid_search", "paid_social"].includes(token)) {
+    return "paid";
+  }
+  if (["organic", "seo"].includes(token)) return "organic";
+  if (["social", "organic_social"].includes(token)) return "social";
+  if (token === "email") return "email";
+  if (token === "referral") return "referral";
+  return "other";
+}
+
+function landingGroup(pathname: string): LandingGroup {
+  const path = pathname.toLowerCase().replace(/^\/(es|en)(?=\/|$)/, "") || "/";
+  if (path === "/") return "home";
+  if (path.startsWith("/auditoria") || path.includes("ats")) return "audit";
+  if (path.startsWith("/precios") || path.startsWith("/pricing")) return "pricing";
+  if (path.startsWith("/blog") || path.startsWith("/recursos") || path.startsWith("/resources")) {
+    return "content";
+  }
+  if (
+    path.startsWith("/mejorar") ||
+    path.startsWith("/adaptar") ||
+    path.startsWith("/resume") ||
+    path.startsWith("/cv")
+  ) {
+    return "tool";
+  }
+  return "other";
+}
+
+function hostname(value: string): string | null {
+  if (!value) return null;
+  try {
+    return new URL(value).hostname.toLowerCase();
+  } catch {
+    return null;
+  }
+}
+
+/** Pure classifier used by the browser adapter and unit tests. */
+export function deriveFirstTouch(href: string, referrer = ""): FirstTouchAttribution {
+  const url = new URL(href);
+  const locale = url.pathname.split("/")[1] === "en" ? "en" : "es";
+  const campaignSource = sourceFromToken(url.searchParams.get("utm_source"));
+  const campaignMedium = mediumFromToken(url.searchParams.get("utm_medium"));
+
+  if (campaignSource || campaignMedium) {
+    return {
+      source: campaignSource ?? "other_campaign",
+      medium: campaignMedium ?? "other",
+      landing: landingGroup(url.pathname),
+      locale,
+    };
+  }
+
+  const referrerHost = hostname(referrer);
+  if (!referrerHost || referrerHost === url.hostname.toLowerCase()) {
+    return { source: "direct", medium: "direct", landing: landingGroup(url.pathname), locale };
+  }
+
+  for (const [pattern, source] of SEARCH_HOSTS) {
+    if (pattern.test(referrerHost)) {
+      return { source, medium: "organic", landing: landingGroup(url.pathname), locale };
+    }
+  }
+
+  for (const [pattern, source] of SOCIAL_HOSTS) {
+    if (pattern.test(referrerHost)) {
+      return { source, medium: "social", landing: landingGroup(url.pathname), locale };
+    }
+  }
+
+  return {
+    source: "other_referral",
+    medium: "referral",
+    landing: landingGroup(url.pathname),
+    locale,
+  };
+}
+
+export function isFirstTouchAttribution(value: unknown): value is FirstTouchAttribution {
+  if (!value || typeof value !== "object") return false;
+  const candidate = value as Record<string, unknown>;
+  return (
+    isOneOf(ATTRIBUTION_SOURCES, candidate.source) &&
+    isOneOf(ATTRIBUTION_MEDIA, candidate.medium) &&
+    isOneOf(LANDING_GROUPS, candidate.landing) &&
+    isOneOf(ANALYTICS_LOCALES, candidate.locale)
+  );
+}
+
+/**
+ * Returns the original classified touch for this browser. No raw URL,
+ * referrer, UTM value, or user-provided content is retained.
+ */
+export function getFirstTouchAttribution(): FirstTouchAttribution {
+  const fallback: FirstTouchAttribution = {
+    source: "direct",
+    medium: "direct",
+    landing: "other",
+    locale: "es",
+  };
+  if (typeof window === "undefined") return fallback;
+
+  try {
+    const stored = window.localStorage.getItem(STORAGE_KEY);
+    if (stored) {
+      const parsed: unknown = JSON.parse(stored);
+      if (isFirstTouchAttribution(parsed)) return parsed;
+    }
+
+    const attribution = deriveFirstTouch(window.location.href, document.referrer);
+    window.localStorage.setItem(STORAGE_KEY, JSON.stringify(attribution));
+    return attribution;
+  } catch {
+    return deriveFirstTouch(window.location.href, document.referrer);
+  }
+}
+
diff --git a/src/lib/analytics/client.ts b/src/lib/analytics/client.ts
new file mode 100644
index 0000000000000000000000000000000000000000..77ac767f3e772f4b56462e1cdf4f219ae06f89f3
--- /dev/null
+++ b/src/lib/analytics/client.ts
@@ -0,0 +1,34 @@
+"use client";
+
+import { track } from "@vercel/analytics";
+import type { AnalyticsEventMap, AnalyticsEventName } from "./contract";
+
+const DEDUPE_PREFIX = "worqai:event:v1:";
+
+export function trackClientEvent<Name extends AnalyticsEventName>(
+  name: Name,
+  properties: AnalyticsEventMap[Name],
+): void {
+  track(name, properties);
+}
+
+/**
+ * Dedupe keys stay in sessionStorage and are never included in the event.
+ * A session ID may be used as `dedupeKey`; it cannot reach Vercel Analytics.
+ */
+export function trackClientEventOnce<Name extends AnalyticsEventName>(
+  name: Name,
+  properties: AnalyticsEventMap[Name],
+  dedupeKey: string,
+): void {
+  if (typeof window === "undefined") return;
+  const storageKey = `${DEDUPE_PREFIX}${name}:${dedupeKey}`;
+  try {
+    if (window.sessionStorage.getItem(storageKey)) return;
+    window.sessionStorage.setItem(storageKey, "1");
+  } catch {
+    // Storage can be unavailable in privacy modes. Tracking still works.
+  }
+  trackClientEvent(name, properties);
+}
+
diff --git a/src/lib/analytics/contract.ts b/src/lib/analytics/contract.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1d0eda7a5b119a6f0c14b0c1471fd305cf560d94
--- /dev/null
+++ b/src/lib/analytics/contract.ts
@@ -0,0 +1,102 @@
+export const ANALYTICS_LOCALES = ["es", "en"] as const;
+export type AnalyticsLocale = (typeof ANALYTICS_LOCALES)[number];
+
+export const ATTRIBUTION_SOURCES = [
+  "direct",
+  "google",
+  "bing",
+  "linkedin",
+  "reddit",
+  "facebook",
+  "instagram",
+  "tiktok",
+  "other_search",
+  "other_referral",
+  "other_campaign",
+] as const;
+export type AttributionSource = (typeof ATTRIBUTION_SOURCES)[number];
+
+export const ATTRIBUTION_MEDIA = [
+  "direct",
+  "organic",
+  "paid",
+  "social",
+  "referral",
+  "email",
+  "other",
+] as const;
+export type AttributionMedium = (typeof ATTRIBUTION_MEDIA)[number];
+
+export const LANDING_GROUPS = [
+  "home",
+  "audit",
+  "pricing",
+  "tool",
+  "content",
+  "other",
+] as const;
+export type LandingGroup = (typeof LANDING_GROUPS)[number];
+
+export const CHECKOUT_SURFACES = ["pricing", "audit", "workbench"] as const;
+export type CheckoutSurface = (typeof CHECKOUT_SURFACES)[number];
+
+export interface FirstTouchAttribution {
+  source: AttributionSource;
+  medium: AttributionMedium;
+  landing: LandingGroup;
+  locale: AnalyticsLocale;
+}
+
+/**
+ * Deliberately closed event map. Callers cannot attach CV text, job text,
+ * names, email addresses, session IDs, URLs, or arbitrary campaign strings.
+ */
+export interface AnalyticsEventMap {
+  audit_start: {
+    locale: AnalyticsLocale;
+    surface: "public" | "workbench";
+  };
+  audit_complete: {
+    locale: AnalyticsLocale;
+    surface: "public" | "workbench";
+  };
+  signup_complete: {
+    locale: AnalyticsLocale;
+    method: "email" | "oauth";
+  };
+  tailor_complete: {
+    locale: AnalyticsLocale;
+  };
+  checkout_start: {
+    locale: AnalyticsLocale;
+    plan: "monthly" | "bundle";
+    surface: CheckoutSurface;
+    first_touch_source: AttributionSource;
+    first_touch_medium: AttributionMedium;
+    first_touch_landing: LandingGroup;
+  };
+  purchase: {
+    locale: AnalyticsLocale | "unknown";
+    plan: "monthly" | "bundle" | "other";
+    surface: CheckoutSurface | "unknown";
+    first_touch_source: AttributionSource | "unknown";
+    first_touch_medium: AttributionMedium | "unknown";
+    first_touch_landing: LandingGroup | "unknown";
+    currency: "usd" | "other";
+    value: number;
+  };
+}
+
+export type AnalyticsEventName = keyof AnalyticsEventMap;
+
+export function normalizeAnalyticsLocale(value: string): AnalyticsLocale {
+  return value === "en" ? "en" : "es";
+}
+
+export function isOneOf<const T extends readonly string[]>(
+  values: T,
+  value: unknown,
+): value is T[number] {
+  return typeof value === "string" && values.includes(value as T[number]);
+}
+
diff --git a/src/lib/analytics/purchase.ts b/src/lib/analytics/purchase.ts
new file mode 100644
index 0000000000000000000000000000000000000000..36addbd79b08d691ba48c6a21b3256eb40d64567
