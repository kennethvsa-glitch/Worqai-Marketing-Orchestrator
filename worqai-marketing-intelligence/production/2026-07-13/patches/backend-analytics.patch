+
+create table public.marketing_conversions (
+  id                  uuid not null primary key default gen_random_uuid(),
+  provider            text not null check (provider in ('polar')),
+  provider_order_id   text not null unique,
+  event_name          text not null check (event_name in ('purchase')),
+  plan                text not null check (plan in ('monthly','bundle','other')),
+  amount_minor        integer not null check (amount_minor >= 0),
+  currency            text not null check (currency ~ '^[A-Z]{3}$'),
+  checkout_surface    text not null check (checkout_surface in ('pricing','audit','workbench','unknown')),
+  first_touch_source  text not null check (first_touch_source in ('direct','google','bing','linkedin','reddit','facebook','instagram','tiktok','other_search','other_referral','other_campaign','unknown')),
+  first_touch_medium  text not null check (first_touch_medium in ('direct','organic','paid','social','referral','email','other','unknown')),
+  first_touch_landing text not null check (first_touch_landing in ('home','audit','pricing','tool','content','other','unknown')),
+  first_touch_locale  text not null check (first_touch_locale in ('es','en','unknown')),
+  purchased_at        timestamptz not null,
+  created_at          timestamptz not null default now()
+);
+
+create index marketing_conversions_purchased_at_idx
+  on public.marketing_conversions (purchased_at desc);
+create index marketing_conversions_attribution_idx
+  on public.marketing_conversions (first_touch_source, first_touch_medium, purchased_at desc);
+
+alter table public.marketing_conversions enable row level security;
+-- Intentionally no client policies. Service-role webhook writes only.
+
