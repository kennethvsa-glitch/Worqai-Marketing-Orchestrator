+import { track } from "@vercel/analytics/server";
+import type { AnalyticsEventMap, AnalyticsEventName } from "./contract";
+
+/** Server events inherit request headers so Vercel can attach session context. */
+export async function trackServerEvent<Name extends AnalyticsEventName>(
+  name: Name,
+  properties: AnalyticsEventMap[Name],
+  request: Request,
+): Promise<void> {
+  await track(name, properties, { request: { headers: request.headers } });
+}
