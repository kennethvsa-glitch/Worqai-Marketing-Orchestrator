+import { describe, expect, it } from "vitest";
+import {
+  deriveFirstTouch,
+  isFirstTouchAttribution,
+} from "@/lib/analytics/attribution";
+
+describe("privacy-safe first-touch attribution", () => {
+  it("classifies Google organic without retaining the query or referrer URL", () => {
+    const result = deriveFirstTouch(
+      "https://www.worqai.io/es/auditoria?q=private-search",
+      "https://www.google.com/search?q=private-search",
+    );
+
+    expect(result).toEqual({
+      source: "google",
+      medium: "organic",
+      landing: "audit",
+      locale: "es",
+    });
+    expect(JSON.stringify(result)).not.toContain("private-search");
+  });
+
+  it("reduces unknown campaign values to closed categories", () => {
+    const result = deriveFirstTouch(
+      "https://www.worqai.io/en/pricing?utm_source=someone%40example.com&utm_medium=email",
+    );
+
+    expect(result).toEqual({
+      source: "other_campaign",
+      medium: "email",
+      landing: "pricing",
+      locale: "en",
+    });
+    expect(JSON.stringify(result)).not.toContain("example.com");
+  });
+
+  it("treats same-origin navigation as direct", () => {
+    expect(
+      deriveFirstTouch(
+        "https://www.worqai.io/es/precios",
+        "https://www.worqai.io/es",
+      ),
+    ).toMatchObject({ source: "direct", medium: "direct" });
+  });
+
+  it("rejects stored values outside the closed contract", () => {
+    expect(
+      isFirstTouchAttribution({
+        source: "email@example.com",
+        medium: "organic",
+        landing: "home",
+        locale: "es",
+      }),
+    ).toBe(false);
+  });
+});
+
