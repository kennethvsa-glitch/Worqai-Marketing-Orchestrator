+++ b/src/lib/analytics/purchase.ts
@@ -0,0 +1,86 @@
+import { supabaseAdmin } from "@/lib/db/supabase-admin";
+import { getBundleProductId, getMonthlySubProductId } from "@/lib/polar/config";
+import {
+  ANALYTICS_LOCALES,
+  ATTRIBUTION_MEDIA,
+  ATTRIBUTION_SOURCES,
+  CHECKOUT_SURFACES,
+  LANDING_GROUPS,
+  isOneOf,
+  type AnalyticsEventMap,
+} from "./contract";
+
+interface PaidOrderInput {
+  orderId: string;
+  productId: string | null;
+  amountMinor: number;
+  currency: string;
+  purchasedAt: Date;
+  metadata: Record<string, unknown>;
+}
+
+function metadataValue(metadata: Record<string, unknown>, key: string): unknown {
+  return metadata[key];
+}
+
+export function purchaseProperties(input: PaidOrderInput): AnalyticsEventMap["purchase"] {
+  const source = metadataValue(input.metadata, "first_touch_source");
+  const medium = metadataValue(input.metadata, "first_touch_medium");
+  const landing = metadataValue(input.metadata, "first_touch_landing");
+  const locale = metadataValue(input.metadata, "first_touch_locale");
+  const surface = metadataValue(input.metadata, "checkout_surface");
+  const plan =
+    input.productId === getBundleProductId()
+      ? "bundle"
+      : input.productId === getMonthlySubProductId()
+        ? "monthly"
+        : "other";
+
+  return {
+    plan,
+    surface: isOneOf(CHECKOUT_SURFACES, surface) ? surface : "unknown",
+    first_touch_source: isOneOf(ATTRIBUTION_SOURCES, source) ? source : "unknown",
+    first_touch_medium: isOneOf(ATTRIBUTION_MEDIA, medium) ? medium : "unknown",
+    first_touch_landing: isOneOf(LANDING_GROUPS, landing) ? landing : "unknown",
+    locale: isOneOf(ANALYTICS_LOCALES, locale) ? locale : "unknown",
+    currency: input.currency.toLowerCase() === "usd" ? "usd" : "other",
+    value: Math.max(0, input.amountMinor) / 100,
+  };
+}
+
+/**
+ * Durable and idempotent: Polar retries do not create duplicate purchase rows.
+ * The table intentionally stores no customer ID, email, IP, CV, or job content.
+ */
+export async function recordPurchase(input: PaidOrderInput): Promise<{
+  inserted: boolean;
+  properties: AnalyticsEventMap["purchase"];
+}> {
+  const properties = purchaseProperties(input);
+  const { error } = await supabaseAdmin.from("marketing_conversions").insert({
+    provider: "polar",
+    provider_order_id: input.orderId,
+    event_name: "purchase",
+    plan: properties.plan,
+    amount_minor: Math.max(0, Math.round(input.amountMinor)),
+    currency: input.currency.toUpperCase().slice(0, 3),
+    checkout_surface: properties.surface,
+    first_touch_source: properties.first_touch_source,
+    first_touch_medium: properties.first_touch_medium,
+    first_touch_landing: properties.first_touch_landing,
+    first_touch_locale: properties.locale,
+    purchased_at: input.purchasedAt.toISOString(),
+  });
+
+  if (error?.code === "23505") {
+    return { inserted: false, properties };
+  }
+  if (error) {
+    console.error("recordPurchase: database error", {
+      orderId: input.orderId,
+      code: error.code,
+    });
+    throw new Error("record_purchase_failed");
+  }
+  return { inserted: true, properties };
+}
