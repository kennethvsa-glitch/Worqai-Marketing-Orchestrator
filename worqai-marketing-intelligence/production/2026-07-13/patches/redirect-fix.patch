diff --git a/src/lib/seo/site.ts b/src/lib/seo/site.ts
index 4e90395ed96fd8853fba71027664c206c258b823..1d8c6402dd7193e9727f0f5492b0eb0b34b72ed2 100644
--- a/src/lib/seo/site.ts
+++ b/src/lib/seo/site.ts
@@ -17,13 +17,21 @@ export function serializeJsonLd(value: unknown): string {
  * API and auth callback traffic deliberately remains on the requested host:
  * webhook providers commonly reject redirects, even when they are permanent.
  */
-export function canonicalHostRedirectUrl(url: URL): URL | null {
+export function canonicalHostRedirectUrl(
+  url: URL,
+  requestHost?: string | null
+): URL | null {
   const pathname = url.pathname;
+  const hostname = (requestHost ?? url.hostname)
+    .split(",")[0]
+    .trim()
+    .split(":")[0]
+    .toLowerCase();
   const isApi = pathname === "/api" || pathname.startsWith("/api/");
   const isAuthCallback =
     pathname === "/auth/callback" || pathname.startsWith("/auth/callback/");
 
-  if (url.hostname !== APEX_HOSTNAME || isApi || isAuthCallback) {
+  if (hostname !== APEX_HOSTNAME || isApi || isAuthCallback) {
     return null;
   }
 
