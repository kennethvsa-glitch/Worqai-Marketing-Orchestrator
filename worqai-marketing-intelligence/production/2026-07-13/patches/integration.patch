+export const ACQUISITION_PAGE_PAIRS = [
+  { es: "analizador-cv-ats", en: "free-ats-resume-checker" },
+  { es: "adaptar-cv-a-vacante", en: "resume-job-description-match" },
+  { es: "mejorar-cv-con-ia", en: "ai-resume-tailor" },
+  { es: "cv-ats", en: "ats-friendly-resume" },
+  { es: "worqai-vs-jobscan", en: "worqai-vs-jobscan" },
+  { es: "alternativas-a-resume-io", en: "jobscan-alternative-for-spanish-resumes" },
+  { es: "cv-analista-datos", en: "data-analyst-resume" },
+  { es: "cv-desarrollador-software", en: "software-engineer-resume" },
+  { es: "cv-product-manager", en: "product-manager-resume" },
+  { es: "cv-marketing-digital", en: "digital-marketing-resume" },
+  { es: "cv-project-manager", en: "project-manager-resume" },
+  { es: "cv-servicio-al-cliente", en: "customer-success-resume" },
+  { es: "cv-contador", en: "accountant-resume" },
+  { es: "cv-ventas", en: "sales-representative-resume" },
+  { es: "cv-recursos-humanos", en: "hr-specialist-resume" },
+  { es: "cv-ciberseguridad", en: "cybersecurity-analyst-resume" },
+] as const;
+
+export function getAcquisitionLanguageAlternates(
+  locale: string,
+  slug: string
+): Record<"es" | "en" | "x-default", string> | undefined {
+  const pair = ACQUISITION_PAGE_PAIRS.find(
+    (candidate) => candidate[locale as AcquisitionLocale] === slug
+  );
+
+  if (!pair) {
+    return undefined;
+  }
+
+  return {
+    es: `/es/${pair.es}`,
+    en: `/en/${pair.en}`,
+    "x-default": `/es/${pair.es}`,
+  };
+}
+
 export function getAcquisitionPage(locale: string, slug: string) {
   return acquisitionPages.find((item) => item.locale === locale && item.slug === slug);
 }
