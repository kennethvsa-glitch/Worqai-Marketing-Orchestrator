      "signals": ["carousel", "slides", "slide deck", "linkedin carousel", "instagram carousel"],
      "source_format": "carousel_spec_json",
      "source_path_template": "production/wmi/{date}/{slug}-spec.json",
      "output_format": "carousel_html_and_zip",
      "output_path_template": "export/{slug}.zip",
      "workflow": ".claude/skills/produce-carousel/SKILL.md",
      "production_commands": [
        "py scripts/creative_job.py new {source}",
        "py scripts/build_carousel.py {source}",
        "py scripts/carousel_exporter.py --input production/carousel_{slug}_s17.html --output {output}"
