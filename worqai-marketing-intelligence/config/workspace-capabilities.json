      "output_format": "motion_video_mp4",
      "output_path_template": "export-video/{slug}.mp4",
      "workflow": ".claude/skills/produce-motion-video/SKILL.md",
      "production_commands": [
        "py .claude/skills/produce-motion-video/scripts/create_job.py {source}",
