    </svg>
  </div>

  <div class="ambient-glow"></div>
  <div id="wound-particles"></div>
</div>

<!-- ════════════════════════════════════════════════════════════════
     BEAT 2: NADA (6–10.5s)
     ════════════════════════════════════════════════════════════════ -->
<div id="nada-group">
  <div class="circle-deco"></div>
  <div class="vert-line"></div>

  <!-- Particles top-left -->
  <div class="particle" style="width:4px;height:4px;opacity:0.5;top:85px;left:55px;box-shadow:0 0 6px rgba(171,243,23,0.5);"></div>
  <div class="particle" style="width:3px;height:3px;opacity:0.35;top:68px;left:90px;box-shadow:0 0 4px rgba(171,243,23,0.4);"></div>
  <div class="particle" style="width:5px;height:5px;opacity:0.45;top:110px;left:125px;box-shadow:0 0 8px rgba(171,243,23,0.5);"></div>
