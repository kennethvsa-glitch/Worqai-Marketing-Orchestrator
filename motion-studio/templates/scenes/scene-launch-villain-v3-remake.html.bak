  <!-- Waves -->
  <div class="waves-container" id="flow-waves">
    <svg width="1080" height="450" viewBox="0 0 1080 450" style="position:absolute;bottom:0;left:0;">
      <path class="wave-path" d="M -50 300 Q 200 260, 400 330 T 800 350 T 1100 300" stroke="#8bc414" stroke-width="0.7" fill="none" opacity="0.1"/>
      <path class="wave-path" d="M -50 330 Q 200 280, 400 360 T 800 370 T 1100 320" stroke="#8bc414" stroke-width="0.9" fill="none" opacity="0.14"/>
      <path class="wave-path" d="M -50 360 Q 200 310, 400 390 T 800 390 T 1100 340" stroke="#8bc414" stroke-width="1.1" fill="none" opacity="0.18"/>
      <path class="wave-path" d="M -50 390 Q 200 340, 400 410 T 800 410 T 1100 360" stroke="#8bc414" stroke-width="0.9" fill="none" opacity="0.12"/>
      <path class="wave-path" d="M -50 420 Q 200 360, 400 440 T 800 440 T 1100 390" stroke="#8bc414" stroke-width="1.2" fill="none" opacity="0.2"/>
      <path class="wave-path" d="M -50 320 Q 300 250, 500 350 T 900 370 T 1100 330" stroke="#abf317" stroke-width="1.4" fill="none" opacity="0.3"/>
      <path class="wave-path" d="M -50 380 Q 300 300, 500 400 T 900 410 T 1100 370" stroke="#abf317" stroke-width="1.6" fill="none" opacity="0.35"/>
      <path class="wave-path" d="M -50 440 Q 300 360, 500 450 T 900 450 T 1100 400" stroke="#abf317" stroke-width="1.4" fill="none" opacity="0.28"/>
      <circle class="glow-dot" cx="150" cy="330" r="3" fill="#abf317" opacity="0.55"/>
      <circle class="glow-dot" cx="350" cy="360" r="2.5" fill="#abf317" opacity="0.5"/>
      <circle class="glow-dot" cx="550" cy="370" r="3.5" fill="#abf317" opacity="0.65"/>
      <circle class="glow-dot" cx="750" cy="350" r="2.5" fill="#abf317" opacity="0.45"/>
      <circle class="glow-dot" cx="250" cy="390" r="3" fill="#abf317" opacity="0.6"/>
      <circle class="glow-dot" cx="450" cy="420" r="3.5" fill="#abf317" opacity="0.7"/>
    </svg>
  </div>

  <div style="position:absolute;bottom:-150px;left:-150px;width:600px;height:600px;border-radius:50%;background:radial-gradient(circle,rgba(171,243,23,0.04)0%,transparent 70%);pointer-events:none;"></div>
</div>

<!-- ════════════════════════════════════════════════════════════════
     BEAT 7: CTA (48–56s) — VERBATIM from original scene
     ════════════════════════════════════════════════════════════════ -->
<div id="cta-group">
  <!-- Decorative layer (behind text) -->
  <div id="cta-particles-layer"></div>
  <svg id="cta-decor" viewBox="0 0 1080 1920" preserveAspectRatio="xMidYMid slice">
    <defs>
      <linearGradient id="cta-trail-grad" x1="0" y1="1" x2="0" y2="0">
        <stop offset="0%"  stop-color="rgba(201,242,77,0)"/>
        <stop offset="60%" stop-color="rgba(201,242,77,0.35)"/>
        <stop offset="100%" stop-color="rgba(201,242,77,0.9)"/>
      </linearGradient>
    </defs>
    <path id="cta-trail" d="M540 1920 C 460 1740, 640 1560, 540 1400 S 460 1240, 560 1150"
          fill="none" stroke="url(#cta-trail-grad)" stroke-width="3" stroke-linecap="round"/>
    <g id="cta-star" transform="translate(560 1150)">
      <path d="M0 -22 L6 -6 L22 0 L6 6 L0 22 L-6 6 L-22 0 L-6 -6 Z"
            fill="#C9F24D"/>
    </g>
  </svg>

  <!-- Content -->
  <div id="cta-logo-wrap"><img id="cta-logo-img" src="../../Ideation/worqai_logo.png" alt="WorqAI"></div>

  <div id="cta-badge">
    <svg class="cta-badge-icon" viewBox="0 0 24 24" fill="none">
      <path d="M13 2L4.5 13.5H11l-1 8.5L19.5 10H13z" fill="currentColor"/>
    </svg>
    <span id="cta-badge-text">TE DESCARTARON EN SEGUNDOS.</span>
  </div>

  <div id="cta-subtext">Sin siquiera llegar a un humano.</div>

  <div id="cta-headline">
    <span class="cta-h-line cta-h-lime">Así que les copiamos el filtro y</span>
    <span class="cta-h-line cta-h-ink">lo pusimos de tu lado.</span>
    <svg id="cta-underline" viewBox="0 0 320 14" preserveAspectRatio="none" aria-hidden="true">
      <path id="cta-underline-path" d="M4 9 C 90 2, 230 2, 316 7" fill="none"
            stroke="#C9F24D" stroke-width="6" stroke-linecap="round"/>
    </svg>
  </div>

  <div id="cta-desc">Con WorqAI podés adaptar tu CV a cualquier vacante <span class="cta-accent">en segundos.</span></div>

  <div id="cta-btn">
    <svg class="cta-btn-icon" viewBox="0 0 24 24" fill="none">
      <path d="M12 2v6m0 8v6m10-10h-6M8 12H2m15.07-7.07l-4.24 4.24M11.17 12.83l-4.24 4.24m12.14 0l-4.24-4.24M11.17 11.17L6.93 6.93" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
    </svg>
    <span id="cta-btn-text">Analiza mi CV gratis</span>
    <span id="cta-btn-arrow" aria-hidden="true">&#8594;</span>
  </div>

  <div id="cta-features">
    <div class="cta-feat">
      <svg class="cta-feat-icon" viewBox="0 0 24 24" fill="none"><path d="M13 2L4.5 13.5H11l-1 8.5L19.5 10H13z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
      <span>Rápido</span>
    </div>
    <span class="cta-feat-sep">·</span>
    <div class="cta-feat">
      <svg class="cta-feat-icon" viewBox="0 0 24 24" fill="none"><path d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
      <span>Seguro</span>
    </div>
    <span class="cta-feat-sep">·</span>
    <div class="cta-feat">
      <svg class="cta-feat-icon" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="3.5" stroke="currentColor" stroke-width="1.5"/></svg>
      <span>Preciso</span>
    </div>
  </div>

  <div id="cta-domain">worqai.io · español e inglés</div>
</div>

<script>
  // ── Lock 1 ───────────────────────────────────────────────────────────────────
  gsap.ticker.lagSmoothing(0);

  // ── Content model ──────────────────────────────────────────────────────────────
  const generic = {
    skills: ["Excel","SQL","Tableau","Power BI","Java","C++","Español nativo","Inglés B2+"]
  };

  const tailors = [
    {
      vacante: "Analista de Seguridad",
      role:    "Monitor de Seguridad & Analista de Incidentes · Bilingüe EN/ES",
      resumen: "Analista de seguridad bilingüe (EN/ES, B2+) con 5 meses en monitoreo de activos. Registros de acceso documentados. Certificado en Excel y SQL.",
      skills:  ["Excel","SQL","Power BI","Seguridad operativa","Control de accesos","Análisis de incidentes","Inglés B2+"],
      bullets: [
        "Monitoreé <span class='kw'>accesos vehiculares</span> en <span class='kw'>3 instalaciones</span> de clientes. Registré <span class='kw'>incidentes</span> y generé <span class='kw'>reportes diarios</span> para supervisores.",
        "Mantuve <span class='kw'>bitácora digital</span> de novedades por turno. Estandaricé el <span class='kw'>formato de reporte</span> para reducir errores de registro.",
        "Gestioné recepción bilingüe (EN/ES) para <span class='kw'>40+ huéspedes</span> diarios. Coordiné <span class='kw'>accesos</span> e <span class='kw'>identificación de visitantes</span>.",
        "Atendí solicitudes de seguridad de huéspedes de varias nacionalidades. Escalé <span class='kw'>incidentes</span> al <span class='kw'>equipo de turno</span>.",
        "Administré <span class='kw'>archivo digital</span> para equipo de 8 personas. Reportes Excel con <span class='kw'>análisis de acceso</span> e inventario.",
        "Diseñé <span class='kw'>plantilla de seguimiento</span> de activos adoptada por el equipo. Redujo el tiempo de <span class='kw'>reporte semanal</span>."
      ],
      score: 92
    },
    {
      vacante: "Analista de Datos · Reporting",
      role:    "Analista de Datos & Reporting · Bilingüe EN/ES",
      resumen: "Analista de datos bilingüe (EN/ES, B2+) certificado en Excel, SQL y Tableau. Experiencia en reportes operativos y análisis de inventario en entornos reales.",
      skills:  ["Excel","SQL","Tableau","Power BI","Análisis de datos","Reporting","Visualización de datos","Inglés B2+"],
      bullets: [
        "Generé <span class='kw'>reportes de control de acceso</span> para 3 instalaciones. Identifiqué <span class='kw'>patrones de incidentes</span> con análisis de tendencias.",
        "Consolidé <span class='kw'>registros diarios</span> en Excel con <span class='kw'>tablas dinámicas</span>. Entregué resúmenes semanales al supervisor de turno.",
        "Produje <span class='kw'>reportes diarios de ocupación</span> para 40+ huéspedes. Mantuve <span class='kw'>base de datos</span> de reservas en Excel.",
        "Crucé datos de reservas y pagos para detectar inconsistencias. Preparé <span class='kw'>reportes de cierre de turno</span> en Excel.",
        "Desarrollé <span class='kw'>reportes semanales de inventario</span> en Excel para equipo de 8. Optimicé <span class='kw'>tablas de seguimiento</span> y cálculos.",
        "Construí <span class='kw'>tableros en Tableau</span> para inventario y consumo. Automaticé cálculos repetitivos con <span class='kw'>fórmulas</span> avanzadas."
      ],
      score: 94
    },
    {
      vacante: "Coordinador Bilingüe",
      role:    "Coordinador Administrativo Bilingüe · EN/ES",
      resumen: "Coordinador bilingüe (EN/ES, B2+) con experiencia en atención y coordinación operativa. Certificado en gestión documental y herramientas de oficina.",
      skills:  ["Inglés B2+","Español nativo","Coordinación operativa","Atención al cliente","Excel","Gestión documental","Comunicación corporativa"],
      bullets: [
        "Coordiné <span class='kw'>accesos y comunicación bilingüe</span> con clientes corporativos en 3 sedes. Generé <span class='kw'>informes diarios</span> de operaciones.",
        "Serví de <span class='kw'>enlace bilingüe</span> entre supervisores y personal de turno. Documenté procedimientos para <span class='kw'>nuevos ingresos</span>.",
        "Coordiné <span class='kw'>check-in y check-out bilingüe</span> para 40+ huéspedes. Atendí solicitudes de <span class='kw'>visitantes de 5+ países</span>.",
        "Gestioné reservas, pagos y quejas en <span class='kw'>turnos de 8 horas</span>. Resolví incidencias de huéspedes en <span class='kw'>EN/ES</span>.",
        "Gestioné <span class='kw'>archivo documental</span> y comunicaciones para equipo de 8 personas. Primer punto de <span class='kw'>contacto bilingüe</span> con clientes externos.",
        "Coordiné <span class='kw'>agenda de reuniones</span> y correspondencia de ejecutivos. Preparé documentos en <span class='kw'>inglés y español</span>."
      ],
      score: 93
    }
  ];

  // ── Initial states ───────────────────────────────────────────────────────────
  gsap.set("#bg-grid",          { opacity: 0 });
  gsap.set("#cursor",           { opacity: 0 });
  gsap.set("#wound-group",      { opacity: 0 });
  gsap.set("#nada-group",       { opacity: 0 });
  gsap.set("#scanner-group",    { opacity: 0 });
  gsap.set("#cheatcode-group",  { opacity: 0 });
  gsap.set("#demo-group",       { opacity: 0 });
  gsap.set("#flow-group",       { opacity: 0 });
  gsap.set("#cta-group",        { opacity: 0 });

  // Wound elements
  gsap.set("#wound-headline",   { opacity: 0, y: 18 });
  gsap.set("#wound-bubble",     { opacity: 0, scale: 0.8 });
  gsap.set("#wound-subtitle",   { opacity: 0 });
  gsap.set("#wound-waves",      { opacity: 0 });
  gsap.set(".wave-path",        { strokeDashoffset: 2000 });
  gsap.set(".glow-dot",         { opacity: 0 });
  gsap.set("#wound-particles",  { opacity: 0 });

  // Nada elements
  gsap.set("#nada-headline",    { opacity: 0, y: 18 });
  gsap.set("#nada-subtitle",    { opacity: 0 });

  // Scanner elements
  gsap.set("#scanner-header",   { opacity: 0, y: -20 });
  gsap.set("#scanner-radar",    { opacity: 0, scale: 0.8 });
  gsap.set("#cv-card-wrapper",  { opacity: 0, clipPath: "inset(100% 0% 0% 0%)" });
  gsap.set("#scanner-stamp",    { opacity: 0, scale: 1.35, rotate: -12 });
  gsap.set("#scanner-analysis", { opacity: 0 });
  gsap.set("#scanner-score",    { opacity: 0 });
  gsap.set(".analysis-item",    { opacity: 0 });
  gsap.set(".highlight",        { opacity: 0 });

  // Cheatcode elements
  gsap.set(".corner",           { opacity: 0, scale: 0.8 });
  gsap.set("#cc-target",        { opacity: 0, scale: 0.8 });
  gsap.set("#cc-headline",      { opacity: 0 });
  gsap.set("#cc-l1",            { opacity: 0, y: 18 });
  gsap.set("#cc-l2",            { opacity: 0, y: 18 });
  gsap.set("#cc-checkline",     { opacity: 0, y: 18 });
  gsap.set("#cc-underline",     { opacity: 0, scaleX: 0, transformOrigin: "left center" });
  gsap.set("#cc-checkcircle",   { opacity: 0, scale: 0.8 });

  // Demo elements
  gsap.set("#header-panel",     { opacity: 0, y: -30 });
  gsap.set("#separator-glow",   { opacity: 0 });
  gsap.set("#resume-card",      { opacity: 0, clipPath: "inset(100% 0% 0% 0%)" });
  gsap.set("#scan-line",        { opacity: 0 });
  gsap.set("#analysis-panel",   { opacity: 0 });
  gsap.set("#score-panel",      { opacity: 0 });
  gsap.set("#demo-cta-btn",     { opacity: 0, scale: 0.9 });
  gsap.set(".check-row",        { opacity: 0 });
  gsap.set("#demo-gauge-fill",  { strokeDashoffset: 150.8 });

  // Flow elements
  gsap.set("#flow-textblock",   { opacity: 0 });
  gsap.set("#flow-l1",          { opacity: 0, y: 18 });
  gsap.set("#flow-l2",          { opacity: 0, y: 18 });
  gsap.set("#flow-l3",          { opacity: 0, y: 18 });
  gsap.set("#flow-l4",          { opacity: 0, y: 18 });
  gsap.set("#flow-worqai-card", { opacity: 0, x: 40 });

  // Flow diagram elements
  gsap.set("#flow-diagram", { opacity: 0 });
  gsap.set(".flow-icon", { opacity: 0, scale: 0.8 });
  gsap.set(".flow-connector", { strokeDashoffset: 500 });
  gsap.set(".flow-dot", { opacity: 0, scale: 0 });

  // CTA elements
  gsap.set(["#cta-logo-wrap","#cta-badge","#cta-subtext","#cta-headline","#cta-desc","#cta-btn","#cta-features","#cta-domain"], { opacity: 0 });
  gsap.set(["#cta-logo-wrap","#cta-btn"], { scale: 0.88 });
  gsap.set("#cta-headline",     { y: 20 });
  gsap.set("#cta-particles-layer", { opacity: 0 });
  gsap.set("#cta-star", { scale: 0, transformOrigin: "center center", opacity: 0 });

  // ── Lock 2 ───────────────────────────────────────────────────────────────────
  gsap.globalTimeline.pause();

  document.fonts.ready.then(() => {
    // Split words for wound + nada headlines
    splitWords("#wound-l1");
    splitWords("#wound-l2");
    splitWords("#wound-subtitle");
    splitWords("#nada-l1");
    splitWords("#nada-l2");
    splitWords("#nada-l3");
    splitWords("#nada-subtitle");

    gsap.set([
      "#wound-l1 .word-inner", "#wound-l2 .word-inner",
      "#wound-subtitle .word-inner"
    ], { y: "100%" });
    gsap.set([
      "#nada-l1 .word-inner", "#nada-l2 .word-inner",
      "#nada-l3 .word-inner", "#nada-subtitle .word-inner"
    ], { y: "100%" });

    // ── Build master timeline ─────────────────────────────────────────────────
    const tl = gsap.timeline();

    // ════════════════════════════════════════════════════════════════════════════
    // BEAT 1 — WOUND (0.0 – 6.0s)
    // ════════════════════════════════════════════════════════════════════════════
    tl.addLabel("wound", 0.0);
    tl.to("#wound-group", { opacity: 1, duration: 0.01 }, 0.0);
    tl.to("#bg-grid", { opacity: 1, duration: 0.6, ease: "none" }, 0.0);

    // Headline word reveals
    tl.to("#wound-l1 .word-inner", { y: "0%", duration: 0.7, ease: "luxe", stagger: 0.05 }, 0.4);
    tl.to("#wound-l2 .word-inner", { y: "0%", duration: 0.6, ease: "luxe", stagger: 0.05 }, 1.5);
    tl.to("#wound-bubble", { opacity: 1, scale: 1, duration: 0.5, ease: "back.out(2)" }, 1.8);
    tl.to("#wound-subtitle .word-inner", { y: "0%", duration: 0.65, ease: "luxe", stagger: 0.05 }, 2.6);

    // Wave draw-in
    tl.to(".wave-path", { strokeDashoffset: 0, duration: 2.0, ease: "power2.out", stagger: 0.05 }, 0.8);
    tl.to(".glow-dot", { opacity: "+=0.3", duration: 3, ease: "sine.inOut", yoyo: true, repeat: -1, stagger: 0.2 }, 2.0);

    // Ambient particles
    tl.to("#wound-particles", { opacity: 1, duration: 0.6 }, 0.2);
    particleField(tl, "#wound-particles", 0.2, {seed:"v3-remake-wound", color:"171,243,23", count:30, drift:24, sizeMin:2, sizeMax:5, opacityMax:0.35, duration:6});

    // Exit wound
    tl.to("#wound-group", { opacity: 0, y: -20, duration: 0.4, ease: "power2.in" }, 5.6);
    tl.to("#wound-group", { opacity: 0, duration: 0.01 }, 6.0);

    // ════════════════════════════════════════════════════════════════════════════
    // BEAT 2 — NADA (6.0 – 10.5s)
    // ════════════════════════════════════════════════════════════════════════════
    tl.addLabel("nada", 6.0);
    tl.to("#nada-group", { opacity: 1, duration: 0.01 }, 6.0);
    tl.to("#nada-l1 .word-inner", { y: "0%", duration: 0.55, ease: "luxe", stagger: 0.05 }, 6.2);
    tl.to("#nada-l2 .word-inner", { y: "0%", duration: 0.55, ease: "luxe", stagger: 0.05 }, 7.0);
    tl.to("#nada-l3 .word-inner", { y: "0%", duration: 0.55, ease: "luxe", stagger: 0.05 }, 7.8);
    tl.to("#nada-subtitle .word-inner", { y: "0%", duration: 0.5, ease: "luxe", stagger: 0.05 }, 8.8);

    // Exit nada
    tl.to("#nada-group", { opacity: 0, y: -20, duration: 0.4, ease: "power2.in" }, 10.1);

    // ════════════════════════════════════════════════════════════════════════════
    // BEAT 3 — SCANNER (10.5 – 18.0s)
    // ════════════════════════════════════════════════════════════════════════════
    tl.addLabel("scanner", 10.5);
    tl.to("#scanner-group", { opacity: 1, duration: 0.01 }, 10.5);
    tl.to("#scanner-header", { opacity: 1, y: 0, duration: 0.5, ease: "power2.out" }, 10.6);
    tl.to("#scanner-radar", { opacity: 1, scale: 1, duration: 0.5, ease: "back.out(2)" }, 10.8);
    tl.to("#cv-card-wrapper", { opacity: 1, clipPath: "inset(0% 0% 0% 0%)", duration: 0.85, ease: "power2.out" }, 11.0);

    // Keyword reveal schedule (simulated via scanSweep)
    const kwSchedule = [];
    document.querySelectorAll(".highlight").forEach((kw, i) => {
      kwSchedule.push({ el: kw, t: 12.5 + i * 0.15 });
    });

    // Scan bar sweep
    tl.set("#scan-bar", { opacity: 0.8 }, 11.5);
    tl.fromTo("#scan-bar", { top: "0%" }, { top: "100%", duration: 2.0, ease: "power1.inOut" }, 11.5);
    kwSchedule.forEach(k => {
      tl.to(k.el, { opacity: 1, duration: 0.2 }, k.t);
    });

    // Stamp at 14.5s
    tl.to("#scanner-stamp", { opacity: 0.85, scale: 1, duration: 0.3, ease: "power2.out" }, 14.5);
    tl.to("#scanner-stamp", { scale: 1.02, duration: 0.1, ease: "power2.out" }, 14.8);
    tl.to("#scanner-stamp", { scale: 1, duration: 0.2, ease: "back.out(2)" }, 14.9);

    // Analysis flags stagger
    tl.to("#scanner-analysis", { opacity: 1, duration: 0.4 }, 15.0);
    tl.to(".analysis-item", { opacity: 1, duration: 0.3, stagger: 0.15 }, 15.2);

    // Score counter
    tl.to("#scanner-score", { opacity: 1, duration: 0.4 }, 15.8);
    tl.to({ val: 0 }, { val: 23, duration: 1.0, ease: "power2.out", onUpdate: function() { document.getElementById("scanner-score-num").textContent = Math.round(this.targets()[0].val); } }, 16.0);

    // Exit scanner
    tl.to("#scanner-group", { opacity: 0, duration: 0.4, ease: "power2.in" }, 17.6);

    // ════════════════════════════════════════════════════════════════════════════
    // BEAT 4 — CHEATCODE (18.0 – 24.5s)
    // ════════════════════════════════════════════════════════════════════════════
    tl.addLabel("cheatcode", 18.0);
    tl.to("#cheatcode-group", { opacity: 1, duration: 0.01 }, 18.0);
    tl.to(".corner", { opacity: 1, scale: 1, duration: 0.4, ease: "back.out(2)", stagger: 0.05 }, 18.1);
    tl.to("#cc-target", { opacity: 1, scale: 1, duration: 0.5, ease: "back.out(2)" }, 18.3);
    tl.to("#cc-l1", { opacity: 1, y: 0, duration: 0.55, ease: "luxe" }, 18.6);
    tl.to("#cc-l2", { opacity: 1, y: 0, duration: 0.55, ease: "luxe" }, 19.6);
    tl.to("#cc-checkcircle", { opacity: 1, scale: 1, duration: 0.4, ease: "back.out(2)" }, 20.6);
    tl.to("#cc-checkline", { opacity: 1, y: 0, duration: 0.45, ease: "luxe" }, 20.8);
    tl.to("#cc-underline", { opacity: 1, scaleX: 1, duration: 0.5, ease: "power2.out" }, 21.2);

    // Exit cheatcode
    tl.to("#cheatcode-group", { opacity: 0, duration: 0.4, ease: "power2.in" }, 24.1);

    // ════════════════════════════════════════════════════════════════════════════
    // BEAT 5 — DEMO (24.5 – 40.0s)
    // ════════════════════════════════════════════════════════════════════════════
    tl.addLabel("demo", 24.5);
    tl.to("#demo-group", { opacity: 1, duration: 0.01 }, 24.5);
    tl.to("#header-panel", { opacity: 1, y: 0, duration: 0.5, ease: "power2.out" }, 24.6);
    tl.to("#separator-glow", { opacity: 0.9, duration: 0.4, ease: "power2.out" }, 24.8);
    tl.to("#resume-card", { opacity: 1, clipPath: "inset(0% 0% 0% 0%)", duration: 0.85, ease: "power2.out" }, 25.0);
    tl.to("#scan-line", { opacity: 1, duration: 0.3 }, 25.5);

    // Scan line sweep down
    tl.fromTo("#scan-line", { top: "0%" }, { top: "100%", duration: 2.0, ease: "power1.inOut" }, 25.5);
    tl.to("#scan-line", { opacity: 0, duration: 0.3 }, 27.5);

    // Analysis panel checkmarks
    tl.to("#analysis-panel", { opacity: 1, duration: 0.4 }, 28.0);
    tl.to(".check-row", { opacity: 1, duration: 0.3, stagger: 0.15 }, 28.2);

    // Score gauge animate
    tl.to("#score-panel", { opacity: 1, duration: 0.4 }, 29.0);
    tl.to("#demo-gauge-fill", { strokeDashoffset: 12.06, duration: 1.2, ease: "power2.out" }, 29.2);
    tl.to({ val: 0 }, { val: 92, duration: 1.2, ease: "power2.out", onUpdate: function() { document.getElementById("demo-gauge-num").textContent = Math.round(this.targets()[0].val); } }, 29.2);

    // CTA button
    tl.to("#demo-cta-btn", { opacity: 1, scale: 1, duration: 0.5, ease: "back.out(2)" }, 30.5);

    // 3 tailor morphs (simplified for remake)
    // Tailor 1
    tl.add(() => { document.getElementById("demo-score-badge").textContent = "Puntuación 92"; }, 31.5);
    // Tailor 2
    tl.add(() => { document.getElementById("demo-score-badge").textContent = "Puntuación 94"; document.getElementById("demo-gauge-num").textContent = "94"; }, 34.0);
    tl.to("#demo-gauge-fill", { strokeDashoffset: 150.8 * (1 - 94/100), duration: 0.5, ease: "power2.out" }, 34.0);
    // Tailor 3
    tl.add(() => { document.getElementById("demo-score-badge").textContent = "Puntuación 93"; document.getElementById("demo-gauge-num").textContent = "93"; }, 36.5);
    tl.to("#demo-gauge-fill", { strokeDashoffset: 150.8 * (1 - 93/100), duration: 0.5, ease: "power2.out" }, 36.5);

    // Exit demo
    tl.to("#demo-group", { opacity: 0, scale: 0.97, duration: 0.5, ease: "power3.out" }, 39.5);

    // ════════════════════════════════════════════════════════════════════════════
    // BEAT 6 — FLOW (40.0 – 48.0s)
    // ════════════════════════════════════════════════════════════════════════════
    tl.addLabel("flow", 40.0);
    tl.to("#flow-group", { opacity: 1, duration: 0.01 }, 40.0);
    tl.to("#flow-l1", { opacity: 1, y: 0, duration: 0.5, ease: "luxe" }, 40.2);
    tl.to("#flow-l2", { opacity: 1, y: 0, duration: 0.5, ease: "luxe" }, 41.0);
    tl.to("#flow-l3", { opacity: 1, y: 0, duration: 0.5, ease: "luxe" }, 41.8);
    tl.to("#flow-l4", { opacity: 1, y: 0, duration: 0.55, ease: "luxe" }, 42.7);
    tl.to("#flow-diagram", { opacity: 1, duration: 0.4 }, 40.5);
    tl.to(".flow-icon", { opacity: 1, scale: 1, duration: 0.4, stagger: 0.2, ease: "back.out(2)" }, 40.8);
    tl.to(".flow-connector", { strokeDashoffset: 0, duration: 1.0, stagger: 0.15, ease: "power2.out" }, 41.0);
    tl.to(".flow-dot", { opacity: 1, scale: 1, duration: 0.2, stagger: 0.1, ease: "back.out(2)" }, 41.5);
    tl.to("#flow-worqai-card", { opacity: 1, x: 0, duration: 0.6, ease: "back.out(1.5)" }, 43.5);

    // Flow waves
    tl.to(".wave-path", { strokeDashoffset: 0, duration: 1.5, ease: "power2.out" }, 40.5);

    // Exit flow
    tl.to("#flow-group", { opacity: 0, duration: 0.4, ease: "power2.out" }, 47.6);

    // ════════════════════════════════════════════════════════════════════════════
    // BEAT 7 — CTA (48.0 – 56.0s) — verbatim timeline from original
    // ════════════════════════════════════════════════════════════════════════════
    const ctaT = 48.0;
    tl.addLabel("cta", ctaT);
    tl.set("#cta-group", { opacity: 1 }, ctaT);

    // ── Decorative layer ──
    const trailEl  = document.getElementById("cta-trail");
    const trailLen = trailEl.getTotalLength();
    tl.set(trailEl, { strokeDasharray: trailLen, strokeDashoffset: trailLen }, ctaT);
    tl.to(trailEl, { strokeDashoffset: 0, duration: 1.4, ease: "power2.inOut" }, ctaT + 0.1);

    tl.to("#cta-star", { opacity: 1, scale: 1, duration: 0.5, ease: "back.out(2)" }, ctaT + 1.3);
    tl.to("#cta-star", { scale: 1.12, duration: 1.1, ease: "sine.inOut", yoyo: true, repeat: -1 }, ctaT + 1.8);

    tl.to("#cta-particles-layer", { opacity: 1, duration: 0.6, ease: "none" }, ctaT + 0.2);
    particleField(tl, "#cta-particles-layer", ctaT + 0.2, {
      count: 46, seed: "v3-cta", color: "201,242,77",
      drift: 48, sizeMin: 2, sizeMax: 5, opacityMax: 0.26, duration: 6.0
    });

    // ── Content reveals ──
    tl.to("#cta-logo-wrap", { opacity: 1, scale: 1, duration: 0.45, ease: "power3.out" }, ctaT + 0.2);
    tl.to("#cta-badge",     { opacity: 1, duration: 0.4, ease: "settle" }, ctaT + 0.7);
    tl.to("#cta-subtext",   { opacity: 1, duration: 0.4, ease: "none" }, ctaT + 1.1);

    tl.to("#cta-headline", { opacity: 1, y: 0, duration: 0.55, ease: "power3.out" }, ctaT + 1.5);
    const ulEl  = document.getElementById("cta-underline-path");
    const ulLen = ulEl.getTotalLength();
    tl.set(ulEl, { strokeDasharray: ulLen, strokeDashoffset: ulLen }, ctaT);
    tl.to(ulEl, { strokeDashoffset: 0, duration: 0.5, ease: "power2.out" }, ctaT + 2.1);

    tl.to("#cta-desc",     { opacity: 1, duration: 0.4, ease: "none" }, ctaT + 2.6);
    tl.to("#cta-btn",      { opacity: 1, scale: 1, duration: 0.5, ease: "back.out(1.8)" }, ctaT + 3.1);
    tl.to("#cta-features", { opacity: 1, duration: 0.4, ease: "none" }, ctaT + 3.7);
    tl.to("#cta-domain",   { opacity: 1, duration: 0.4, ease: "none" }, ctaT + 4.2);

    signalReady(tl);
  });
</script>
</body>
</html>
