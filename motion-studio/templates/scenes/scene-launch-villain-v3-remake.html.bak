  <!-- Headline -->
  <div class="headline-block" id="wound-headline">
    <div class="headline-line" id="wound-l1"><span class="num">40</span><span class="txt"> postulaciones.</span></div>
    <div class="headline-line line2" id="wound-l2"><span class="num">0</span><span class="txt"> respuestas.</span></div>
  </div>

  <!-- Bubble icon -->
  <div class="bubble-icon" id="wound-bubble">
    <svg width="56" height="68" viewBox="0 0 56 68" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M 28 2 C 42 2, 52 12, 52 26 L 52 46 C 52 50, 50 52, 46 52 L 18 52 L 6 64 L 10 52 C 6 52, 4 50, 4 46 L 4 26 C 4 12, 14 2, 28 2Z" stroke="#abf317" stroke-width="2.5" fill="#010509"/>
    </svg>
  </div>

  <!-- Subtitle -->
  <div class="subtitle-text" id="wound-subtitle">
    Y la pregunta que te persigue: <span class="quote">"¿qué estoy haciendo<br>mal?"</span>
  </div>

  <!-- Waves -->
  <div class="waves-container" id="wound-waves">
    <svg width="1200" height="680" viewBox="0 0 1200 680" style="position:absolute;bottom:0;left:-100px;">
